# Copy to .env and fill values (do not commit .env).

# Azure OpenAI — required for AutoGen (not committed; set from Azure Portal)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_BASE=https://YOUR-RESOURCE.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
GPT4_LLM_MODEL_DEPLOYMENT_NAME=
EMBEDDING_MODEL=

# Azure AI Search
AZURE_SEARCH_SERVICE_ENDPOINT=
AZURE_SEARCH_ADMIN_KEY=
IN_NAME=dupont_email_demo

# GraphRAG OpenAI (empty = reuse main above)
GRAPH_API_KEY=
GRAPH_API_BASE=
GRAPH_LLM_MODEL=gpt-4o

# Azure SQL (intern defaults may work with provided credentials)
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=
AZURE_SQL_SCHEMA=dbo

# pipeline (default) | groupchat (AutoGen rollback)
ORCHESTRATOR=pipeline

# Core JEV gates (see docs/ARCHITECTURE_JEV.md)
JEV_API_KEY=
JEV_ROUTING_ENABLED=true
JEV_S1_SAFETY_ENABLED=true
# off | grey_zone | always (default always until shadow+tune pass)
SAFETY_LLM_MODE=off
SAFETY_JEV_ALLOW_LOW=0.05
SAFETY_JEV_BLOCK_HIGH=0.55
S14_PII_REDACT_ENABLED=true
JEV_S7_SQL_RESULT_ENABLED=false
JEV_S9_EVAL_ENABLED=true
JEV_S13_CRITIC_ENABLED=true
JEV_TIMEOUT_MS=1500
JEV_RETRY_MAX=3
JEV_RETRY_BASE_MS=500
JEV_MAX_CONCURRENCY=2
PRESTAGE_PARALLEL_ENABLED=true
PRESTAGE_WALL_S=8
PRESTAGE_MAX_WORKERS=5
# 0 = derive from JEV_TIMEOUT_MS
PRESTAGE_ARM_TIMEOUT_S=0
JEV_SHADOW_MODE=false
BENCH_RUNS=3
LLM_RESPONSE_CACHE=false
LLM_RESPONSE_CACHE_SEED=41
LLM_RESPONSE_CACHE_DIR=.cache
BENCH_CORRECTNESS_REL_TOLERANCE=0.05
SQL_MAX_REPAIR_ROUNDS=3
LLM_REQUEST_TIMEOUT_S=120
SQL_QUERY_TIMEOUT_S=60
REQUEST_TIMEOUT_S=600

# Optional per-request trace (default off in production)
TRACE_PRINT_SUMMARY=false
TRACE_PERSIST=false
TRACE_PERSIST_DIR=.cache/traces